<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Empreinte mémoire — le SDK Web active le Server GC par défaut (un heap par cœur logique,
         collectes tardives), ce qui faisait grimper le RSS du conteneur à ~1,5 Go sans jamais
         redescendre. Inkhound est une app self-hosted mono-utilisateur : le Workstation GC (un
         seul heap, collectes bien plus fréquentes) est le bon compromis, et le déclarer ici — et
         non en variable d'environnement du Dockerfile — aligne le comportement local et Docker.
         InvariantGlobalization doit rester à false : BedethequeTitleNormalizer dépend des
         comparaisons culturelles. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.*" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Inkhound.Core\Inkhound.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="data\import\" />
    <Folder Include="data\working\" />
  </ItemGroup>

</Project>
